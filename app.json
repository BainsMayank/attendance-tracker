{
  "expo": {
    "name": "attendance-tracker",
    "slug": "attendance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./store-assets/icon-1024.png",
    "scheme": "attendancetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5276",
        "foregroundImage": "./store-assets/adaptive-foreground.png",
        "monochromeImage": "./store-assets/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.bainsmayank.attendancetracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to save with your subject files.",
          "cameraPermission": "Take photos to save with your subject files.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your attendance workspace."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
